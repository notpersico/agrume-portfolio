---
import { getCollection } from 'astro:content';

// Layout import — provides basic page elements: <head>, <nav>, <footer> etc.
import BaseLayout from '../layouts/BaseLayout.astro';

// Component Imports
import CallToAction from '../components/CallToAction.astro';
import Grid from '../components/Grid.astro';
import Hero from '../components/Hero.astro';
import Icon from '../components/Icon.astro';
import Pill from '../components/Pill.astro';
import PortfolioPreview from '../components/PortfolioPreview.astro';

// Page section components
import ContactCTA from '../components/ContactCTA.astro';
import Skills from '../components/Skills.astro';

// Content Fetching: List four most recent work projects
const projects = (await getCollection('work'))
	.sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
	.slice(0, 4);

// Full Astro Component Syntax:
// https://docs.astro.build/basics/astro-components/
---

<BaseLayout>
	<div class="stack gap-20 lg:gap-48">
		<header class="hero">
			<Hero
				title="Agenzia Agrume"
				tagline="Soluzioni di marketing e comunicazione integrate per aziende di diversi settori. Specializzati in strategie digitali, identità visiva e sviluppo web."
				align="start"
			>
				<!-- Optional: Add relevant pills if desired -->
				<!-- <div class="roles">
					<Pill><Icon icon="code" size="1.33em" /> Sviluppo Web</Pill>
					<Pill><Icon icon="palette" size="1.33em" /> Branding</Pill>
					<Pill><Icon icon="megaphone" size="1.33em" /> Marketing</Pill>
				</div> -->
			</Hero>

			<!-- <img
				alt="Illustrazione astratta Agrume"
				width="480"
				height="620"
				src="/images/stock-5.jpg"
			/> -->
		</header>

		<!-- Removed Skills section -->

		<main class="wrapper stack gap-20 lg:gap-48">
			<!-- Introduction Section -->
			<section class="section stack gap-8 lg:gap-12">
				<header class="section-header stack gap-2 lg:gap-4 align-start">
					<h3>Introduzione</h3>
				</header>
				<div class="content">
					<p>
						Agrume è un'agenzia di marketing e comunicazione che offre soluzioni integrate per aziende di diversi settori. Specializzata in strategie di marketing digitale, identità visiva e sviluppo web, Agrume si distingue per un approccio orientato ai risultati e per la capacità di adattare le proprie soluzioni alle specifiche esigenze di ogni cliente, indipendentemente dalle dimensioni e dal budget disponibile.
					</p>
 					<p>
						Questo documento raccoglie una selezione di case study che illustrano la varietà di progetti gestiti dall'agenzia e i risultati concreti ottenuti per i clienti.
					</p>
				</div>
			</section>

			<!-- Selected Work Section -->
			<section class="section with-background with-cta">
				<header class="section-header stack gap-2 lg:gap-4">
					<h3>Case Study Selezionati</h3>
					<p>Dai un'occhiata qui sotto ad alcuni dei nostri progetti principali degli ultimi anni.</p>
				</header>

				<div class="gallery">
					<Grid variant="offset">
						{
							projects.map((project) => (
								<li>
									<PortfolioPreview project={project} />
								</li>
							))
						}
					</Grid>
				</div>

				<div class="cta">
					<CallToAction href="/work/">
						Vedi Tutti
						<Icon icon="arrow-right" size="1.2em" />
					</CallToAction>
				</div>
			</section>

			<!-- Removed Mentions section -->

			<!-- Conclusion Section -->
			<section class="section stack gap-8 lg:gap-12">
				<header class="section-header stack gap-2 lg:gap-4 align-start">
					<h3>Conclusioni</h3>
				</header>
				<div class="content">
					<p>
						I case study presentati illustrano l'approccio versatile e orientato ai risultati di Agrume. Attraverso questi progetti, emergono alcuni punti di forza distintivi dell'agenzia:
					</p>
					<ol>
						<li><strong>Capacità di ottenere risultati concreti con budget limitati:</strong> Come dimostrato nei casi Gameboy.custom Italia e Ridesphere, l'agenzia riesce a sviluppare strategie efficaci anche con risorse economiche contenute.</li>
						<li><strong>Approccio integrato alla comunicazione:</strong> Dai progetti di identità visiva come Pionia e Ruga, emerge la capacità di creare sistemi di comunicazione coerenti che abbracciano sia il mondo fisico che quello digitale.</li>
						<li><strong>Competenza in diversi settori:</strong> I case study spaziano dalla ristorazione alla tecnologia, dalla gioielleria ai servizi finanziari, dimostrando l'adattabilità dell'agenzia a contesti di business molto diversi.</li>
						<li><strong>Focus sul marketing organico:</strong> Un elemento ricorrente è l'attenzione alla crescita organica, con strategie che privilegiano la qualità dei contenuti e l'ottimizzazione per i motori di ricerca.</li>
						<li><strong>Orientamento ai risultati:</strong> Ogni progetto è caratterizzato da obiettivi chiari e risultati misurabili, evidenziando l'approccio pragmatico dell'agenzia.</li>
					</ol>
 					<p>
						Agrume si propone come un partner strategico per le aziende che cercano non solo creatività, ma anche efficacia e concretezza nei loro progetti di comunicazione e marketing digitale.
					</p>
				</div>
			</section>
		</main>

		<ContactCTA />
	</div>
</BaseLayout>

<style>
	.hero {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 2rem;
	}

	.roles {
		display: none;
	}

	.hero img {
		aspect-ratio: 5 / 4;
		object-fit: cover;
		object-position: top;
		border-radius: 1.5rem;
		box-shadow: var(--shadow-md);
	}

	@media (min-width: 50em) {
		.hero {
			display: grid;
			grid-template-columns: 6fr 4fr;
			padding-inline: 2.5rem;
			gap: 3.75rem;
		}

		.roles {
			margin-top: 0.5rem;
			display: flex;
			gap: 0.5rem;
		}

		.hero img {
			aspect-ratio: 3 / 4;
			border-radius: 4.5rem;
			object-fit: cover;
		}
	}

	/* ====================================================== */

	.section {
		display: grid;
		gap: 2rem;
	}

	.with-background {
		position: relative;
	}

	.with-background::before {
		--hero-bg: var(--bg-image-subtle-2);

		content: '';
		position: absolute;
		pointer-events: none;
		left: 50%;
		width: 100vw;
		aspect-ratio: calc(2.25 / var(--bg-scale));
		top: 0;
		transform: translateY(-75%) translateX(-50%);
		background:
			url('/assets/backgrounds/noise.png') top center/220px repeat,
			var(--hero-bg) center center / var(--bg-gradient-size) no-repeat,
			var(--gray-999);
		background-blend-mode: overlay, normal, normal, normal;
		mix-blend-mode: var(--bg-blend-mode);
		z-index: -1;
	}

	.with-background.bg-variant::before {
		--hero-bg: var(--bg-image-subtle-1);
	}

	.section-header {
		justify-self: center;
		text-align: center;
		max-width: 50ch;
		font-size: var(--text-md);
		color: var(--gray-300);
	}

	.section-header h3 {
		font-size: var(--text-2xl);
	}

	@media (min-width: 50em) {
		.section {
			grid-template-columns: repeat(4, 1fr);
			grid-template-areas: 'header header header header' 'gallery gallery gallery gallery';
			gap: 5rem;
		}

		.section.with-cta {
			grid-template-areas: 'header header header cta' 'gallery gallery gallery gallery';
		}

		.section-header {
			grid-area: header;
			font-size: var(--text-lg);
		}

		.section-header h3 {
			font-size: var(--text-4xl);
		}

		.with-cta .section-header {
			justify-self: flex-start;
			text-align: left;
		}

		.gallery {
			grid-area: gallery;
		}

		.cta {
			grid-area: cta;
		}
	}

	/* ====================================================== */

	.mention-card {
		display: flex;
		height: 7rem;
		justify-content: center;
		align-items: center;
		text-align: center;
		border: 1px solid var(--gray-800);
		border-radius: 1.5rem;
		color: var(--gray-300);
		background: var(--gradient-subtle);
		box-shadow: var(--shadow-sm);
	}

	@media (min-width: 50em) {
		.mention-card {
			border-radius: 1.5rem;
			height: 9.5rem;
		}
	}

	.content {
		/* Add styles for introduction and conclusion content if needed */
		color: var(--gray-300);
		max-width: 70ch; /* Adjust as needed */
	}

	.content p, .content ol {
		margin-bottom: 1em;
	}

	.content ol {
		list-style: decimal;
		padding-left: 2em; /* Adjust for desired indentation */
	}

	.content li {
		margin-bottom: 0.5em;
	}

	.align-start {
		justify-self: start;
		text-align: left;
	}

	/* Ensure header styles apply correctly */
	.section-header.align-start {
		justify-self: start;
		text-align: left;
	}
</style>
